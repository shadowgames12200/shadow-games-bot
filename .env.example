DATABASE_URL=
DATABASE_SSL=true
DISCORD_TOKEN=
DASHBOARD_TOKEN=
DASHBOARD_PUBLIC=false
MP_ACCESS_TOKEN=

# Efí Bank — API Pix
# O ambiente é selecionado no painel do Discord; este módulo não lê EFI_MODE.
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
# Recomendado para hosts gerenciados: P12/PFX convertido para Base64.
EFI_CERT_P12_BASE64=
EFI_CERT_P12_PASSWORD=
# Alternativa: certificado + chave PEM em Base64.
EFI_CERT_BASE64=
EFI_KEY_BASE64=
EFI_KEY_PASSWORD=
# Alternativa para hosts com arquivos persistentes/secret files.
EFI_CERT_P12_PATH=
EFI_CERT_PATH=
EFI_KEY_PATH=

# Banco Inter (não habilitado no checkout deste projeto)
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=
INTER_KEY_PATH=
INTER_PIX_KEY=

# Banco do Brasil (não habilitado no checkout deste projeto)
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_CERT_PATH=
BB_KEY_PATH=
BB_PIX_KEY=

# Asaas (alternativa existente)
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=
